rule workspace_mfa_disabled {
  meta:
    author = "Security Operations Center"
    description = "Triggers a critical alert if multi-factor authentication (2-Step Verification) is disabled for a user or by an administrator."
    severity = "CRITICAL"
    mitre_attack_technique = "T1556" // Modify Authentication Process

  events:
    // Filter for Google Workspace Admin Audit Logs
    $log.metadata.vendor = "Google Workspace"
    $log.metadata.product = "Google Admin"
    
    // Look for security setting updates, specifically 2SV/MFA deactivation
    $log.metadata.event_type = "USER_RESOURCE_UPDATE_SETTINGS"
    
    // Match Google Workspace specific MFA disable action names
    (
      $log.metadata.description = /Disable 2-Step Verification/ or
      $log.metadata.description = /Turn off 2-Step Verification/ or
      $log.metadata.description = /mfa_disabled/
    )

    // Capture the administrator or user who made the change
    $log.principal.user.email_addresses = $actor_email
    
    // Capture the target user account that lost MFA protection
    $log.target.user.email_addresses = $target_email

  match:
    $target_email over 5m

  condition:
    $log
}
