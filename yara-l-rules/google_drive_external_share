rule google_drive_external_share {
  meta:
    author = "AI Assistant"
    description = "HIPAA Compliance: Detects Google Drive files shared with external domains."
    severity = "HIGH"

  events:
    $drive.metadata.product_name = "Google Workspace"
    $drive.metadata.event_type = "USER_RESOURCE_UPDATE"
    $drive.metadata.description = "permissions_change"
    
    // Target the specific action of adding an external user
    $drive.target.resource.attribute.labels["target_domain"] != "yourcompany.com"
    $drive.principal.user.userid = $actor

  match:
    $actor over 5m

  condition:
    $drive
}
