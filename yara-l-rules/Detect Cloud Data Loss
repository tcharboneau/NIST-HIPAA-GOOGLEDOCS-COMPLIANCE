rule cloud_data_loss_exfiltration {
  meta:
    author = "AI Assistant"
    description = "Detects an anomalous volume of document downloads or external shares by a single user."
    severity = "MEDIUM"

  events:
    // Focuses on typical cloud storage download or permission modification actions
    ($db.metadata.event_type = "USER_RESOURCE_ACCESS" or $db.metadata.event_type = "RESOURCE_REMOVAL")
    $db.metadata.product_name = "Google Workspace" // Adaptable to AWS CloudTrail / O365
    $db.security_result.action = "ALLOW"
    $db.target.resource.attribute.labels["sensitive"] = "true"
    $db.principal.user.userid = $user

  match:
    $user over 5m

  condition:
    #db >= 10 // Alerts if 10 or more sensitive actions occur in 5 minutes
}
