rule chromeos_unauthorized_usb_copying {
  meta:
    author = "Google Fleet Security Operations"
    description = "Detects rapid file transfers to a mounted USB flash drive on a managed ChromeOS Enterprise device."
    severity = "HIGH"
    mitre_attack_technique = "T1052.001" // Exfiltration Over Physical Medium: USB Device

  events:
    // 1. Capture ChromeOS Hardware Peripheral insertion telemetry
    $usb_mount.metadata.event_type = "DEVICE_CONTROL" 
    $usb_mount.metadata.product_name = "ChromeOS_XDR"
    $usb_mount.target.resource.attribute.labels["peripheral_type"] = "MASS_STORAGE"
    $usb_mount.principal.hostname = $hostname
    $usb_mount.principal.user.userid = $user

    // 2. Capture ChromeOS File Creation/Modification events 
    $file_write.metadata.event_type = "USER_RESOURCE_CREATION"
    $file_write.metadata.product_name = "ChromeOS_XDR"
    $file_write.principal.hostname = $hostname
    $file_write.principal.user.userid = $user

    // ChromeOS mounts external USB storage devices under the "/media/removable/" path
    $file_write.target.file.full_path = /^\/media\/removable\//

    // 3. Ensure the file actions occur during/after the hardware mount session
    $usb_mount.metadata.event_timestamp.seconds <= $file_write.metadata.event_timestamp.seconds

  match:
    // Correlation window tracking user activity on a specific device
    $hostname, $user over 5m

  outcome:
    // Forensic data compilation for incident responders
    $total_files_transferred = count($file_write.metadata.id)
    $copied_files_list = array_distinct($file_write.target.file.full_path)
    $chrome_hardware_id = max($usb_mount.target.resource.id)

  condition:
    // Alert if more than 10 files hit a removable ChromeOS directory inside a 5-minute block
    $usb_mount and $total_files_transferred >= 10
}
