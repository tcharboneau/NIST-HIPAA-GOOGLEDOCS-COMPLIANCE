rule multi_failed_logins_followed_by_success {
  meta:
    author = "Security Operations Team"
    description = "Detects multiple failed login attempts followed by a successful login within a 10-minute window."
    severity = "HIGH"
    mitre_attack_technique = "T1110.001" // Brute Force: Password Guessing

  events:
    // 1. Capture failed login attempts
    $failed.metadata.event_type = "USER_LOGIN"
    $failed.security_result.action = "BLOCK"
    $failed.target.user.userid = $user

    // 2. Capture a successful login attempt
    $success.metadata.event_type = "USER_LOGIN"
    $success.security_result.action = "ALLOW"
    $success.target.user.userid = $user

    // 3. Ensure chronological ordering (failed attempts happen before success)
    $failed.metadata.event_timestamp.seconds < $success.metadata.event_timestamp.seconds

  match:
    // Group occurrences by the unique user ID within a 10-minute temporal window
    $user over 10m

  outcome:
    // Compute additional context for the analyst
    $total_failed_attempts = count($failed.metadata.id)
    $target_user = max($failed.target.user.userid)

  condition:
    // Trigger the alert if there are 5 or more failed logins before the success
    #failed >= 5 and $success
}
