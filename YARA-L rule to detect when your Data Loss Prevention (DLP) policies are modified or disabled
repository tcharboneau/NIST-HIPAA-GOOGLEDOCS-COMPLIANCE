rule workspace_dlp_policy_tampering {
  meta:
    author = "SecOps Team"
    description = "Alerts when a Google Workspace Data Loss Prevention (DLP) rule is modified, disabled, or deleted."
    severity = "CRITICAL"
    mitre_attack_tactic = "Defense Evasion"
    mitre_attack_technique = "T1562.001"

  events:
    // 1. Monitor Google Workspace Admin Console events
    $workspace.metadata.vendor_name = "Google Workspace"
    $workspace.metadata.product_name = "Admin"
    
    // 2. Target administrative rule modifications
    $workspace.metadata.event_type = "RULE_SETTINGS_UPDATE"
    
    // 3. Isolate DLP specific changes via the log description
    $workspace.metadata.description = /data\s?loss\s?prevention|dlp/i
    
    // 4. Capture the admin who made the change and the specific rule name targeted
    $workspace.principal.user.email_addresses = $admin_email
    $workspace.target.resource.name = $dlp_rule_name

  match:
    // Group alerts by the specific DLP rule name over a 5-minute window
    $dlp_rule_name over 5m

  condition:
    // Trigger immediately to alert the security team of potential unauthorized changes
    $workspace
}
